// firestore.rules
// Deploy with: firebase deploy --only firestore:rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ───────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isOfficeUser(officeId) {
      return isSignedIn() && getUserData().officeId == officeId;
    }

    function isAdmin() {
      return isSignedIn() && getUserData().role == 'admin';
    }

    // ─── Users ───────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if false; // managed by backend/admin SDK only
    }

    // ─── Offices ─────────────────────────────────────────────────────
    match /offices/{officeId} {
      allow read: if isOfficeUser(officeId);
      allow write: if false; // admin SDK only
    }

    // ─── Orders ──────────────────────────────────────────────────────
    match /orders/{orderId} {
      allow read: if isSignedIn()
        && resource.data.officeId == getUserData().officeId;

      allow create: if isSignedIn()
        && request.resource.data.officeId == getUserData().officeId
        && request.resource.data.status == 'pending'
        && request.resource.data.driverId == null;

      allow update: if isSignedIn()
        && resource.data.officeId == getUserData().officeId
        && request.resource.data.officeId == resource.data.officeId; // can't change office

      allow delete: if isSignedIn()
        && resource.data.officeId == getUserData().officeId
        && isAdmin();
    }

    // ─── Drivers ─────────────────────────────────────────────────────
    match /drivers/{driverId} {
      allow read: if isSignedIn()
        && resource.data.officeId == getUserData().officeId;

      allow create: if isSignedIn()
        && request.resource.data.officeId == getUserData().officeId
        && isAdmin();

      allow update: if isSignedIn()
        && resource.data.officeId == getUserData().officeId;

      allow delete: if isSignedIn()
        && resource.data.officeId == getUserData().officeId
        && isAdmin();
    }
  }
}
