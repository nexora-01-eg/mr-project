rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return userDoc().data.role;
    }

    function officeId() {
      return userDoc().data.officeId;
    }

    function isSuperAdmin() {
      return role() == 'super_admin';
    }

    function sameOffice(resourceOfficeId) {
      return officeId() != null && officeId() == resourceOfficeId;
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if isSuperAdmin();
    }

    match /offices/{officeIdDoc} {
      allow read: if isSignedIn() && (isSuperAdmin() || officeId() == officeIdDoc);
      allow create, update, delete: if isSignedIn() && (isSuperAdmin() || role() == 'office_owner') && officeId() == officeIdDoc;
    }

    match /orders/{id} {
      allow read, create, update, delete: if isSignedIn() && (isSuperAdmin() || sameOffice(resource.data.officeId) || (request.resource.data.officeId != null && sameOffice(request.resource.data.officeId)));
    }

    match /drivers/{id} {
      allow read, create, update, delete: if isSignedIn() && (isSuperAdmin() || sameOffice(resource.data.officeId) || (request.resource.data.officeId != null && sameOffice(request.resource.data.officeId)));
    }

    match /calls/{id} {
      allow read, create, update, delete: if isSignedIn() && (isSuperAdmin() || sameOffice(resource.data.officeId) || (request.resource.data.officeId != null && sameOffice(request.resource.data.officeId)));
    }

    match /transactions/{id} {
      allow read, create, update, delete: if isSignedIn() && (isSuperAdmin() || sameOffice(resource.data.officeId) || (request.resource.data.officeId != null && sameOffice(request.resource.data.officeId)));
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
